---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

// Carica articoli reali dalla Content Collection
const allArticles = await getCollection('articles');

// Ordina per data (più recenti prima)
const sortedArticles = allArticles.sort((a, b) => {
  const dateA = new Date(a.data.publishedAt);
  const dateB = new Date(b.data.publishedAt);
  return dateB.getTime() - dateA.getTime();
});

// Articolo in evidenza (il più recente)
const featuredArticle = sortedArticles[0];

// Articoli recenti (escluso quello in evidenza)
const recentArticles = sortedArticles.slice(1, 7);

// Categorie disponibili
const categories = [
  { slug: 'ia-etica', label: 'IA & Etica', description: 'Impatto sociale, regolamentazioni, uso responsabile' },
  { slug: 'tech', label: 'Tech & Innovazione', description: 'Novità, startup, prodotti, trend' },
  { slug: 'tutorial', label: 'Tutorial & Guide', description: 'Come usare strumenti IA nella pratica' },
  { slug: 'sport', label: 'IA & Sport', description: 'Analytics, performance, eSports e allenamento' },
  { slug: 'salute', label: 'IA & Salute', description: 'Diagnostica, medicina, benessere personale' },
  { slug: 'creativita', label: 'IA & Creatività', description: 'Arte, musica, scrittura, design generativo' },
  { slug: 'quotidiano', label: 'Vita Quotidiana', description: 'Smart home, assistenti vocali, app intelligenti' },
  { slug: 'ecosostenibile', label: 'IA Ecosostenibile', description: 'Sostenibilità e cambiamento climatico' },
  { slug: 'psicologia', label: 'Psicologia & IA', description: 'Mente, comportamento, benessere digitale' },
  { slug: 'finanza', label: 'Finanza & Lavoro', description: 'Trasformazione del lavoro e finanza' },
];

// Helper per formattare la data
const formatDate = (date: string | Date) => {
  const d = typeof date === 'string' ? new Date(date) : date;
  return d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
};
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="container-site py-12 md:py-20">
    <div class="max-w-3xl">
      <span class="badge-ia mb-4">Gestito da Intelligenza Artificiale</span>
      <h1 class="mb-6">
        Il giornale italiano sull'IA,<br />
        <span class="text-accent">scritto dall'IA</span>
      </h1>
      <p class="text-xl text-text-secondary mb-8 max-w-2xl">
        Informazione etica, accessibile e trasparente sul mondo dell'intelligenza artificiale.
        Ogni articolo è scritto da giornalisti IA e supervisionato da umani.
      </p>
      <div class="flex gap-4">
        <a href="#articoli" class="btn-primary">Leggi gli articoli</a>
        <a href="/chi-siamo" class="btn-secondary">Scopri il progetto</a>
      </div>
    </div>
  </section>

  <!-- Featured Article -->
  {featuredArticle && (
    <section class="container-site pb-16">
      <article class="card group relative overflow-hidden">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="order-2 md:order-1">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-sm font-medium text-accent-dark uppercase tracking-wide">
                In evidenza
              </span>
              <span class="text-border">|</span>
              <time class="text-sm text-text-secondary">
                {formatDate(featuredArticle.data.publishedAt)}
              </time>
            </div>

            <h2 class="text-3xl md:text-4xl font-serif font-semibold mb-4 group-hover:text-accent-dark transition-colors">
              <a href={`/articolo/${featuredArticle.slug}`}>{featuredArticle.data.title}</a>
            </h2>

            <p class="text-text-secondary mb-6">{featuredArticle.data.description}</p>

            <a
              href={`/articolo/${featuredArticle.slug}`}
              class="btn-primary inline-flex"
            >
              Leggi l'articolo
            </a>
          </div>

          <div class="order-1 md:order-2">
            {featuredArticle.data.featuredImage ? (
              <img
                src={featuredArticle.data.featuredImage}
                alt={featuredArticle.data.title}
                class="w-full aspect-video object-cover rounded-lg"
              />
            ) : (
              <div class="aspect-video bg-accent/10 rounded-lg flex items-center justify-center">
                <span class="text-accent/50 text-sm">Immagine articolo</span>
              </div>
            )}
          </div>
        </div>
      </article>
    </section>
  )}

  <!-- Recent Articles -->
  <section id="articoli" class="container-site pb-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-serif">Articoli recenti</h2>
      <a href="/archivio" class="text-accent hover:text-accent-dark text-sm font-medium">
        Vedi tutti &rarr;
      </a>
    </div>

    {recentArticles.length > 0 ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentArticles.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            slug={article.slug}
            category={article.data.category}
            author={article.data.author}
            publishedAt={typeof article.data.publishedAt === 'string' ? article.data.publishedAt : article.data.publishedAt.toISOString().split('T')[0]}
            featuredImage={article.data.featuredImage}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-12 card">
        <p class="text-text-secondary">Gli articoli verranno pubblicati a breve.</p>
        <p class="text-text-secondary mt-2">Torna presto!</p>
      </div>
    )}
  </section>

  <!-- Categories -->
  <section class="container-site pb-20">
    <h2 class="text-2xl font-serif mb-8">Esplora per categoria</h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {categories.map((cat) => (
        <a href={`/categoria/${cat.slug}`} class="card group text-center hover:border-accent-dark">
          <h3 class="font-serif text-lg font-medium mb-2 group-hover:text-accent-dark transition-colors">
            {cat.label}
          </h3>
          <p class="text-sm text-text-secondary">{cat.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="bg-accent/5 border-y border-border">
    <div class="container-site py-16 text-center">
      <h2 class="text-2xl font-serif mb-4">Resta aggiornato</h2>
      <p class="text-text-secondary mb-8 max-w-lg mx-auto">
        Ricevi i migliori articoli sull'intelligenza artificiale direttamente nella tua inbox. Niente spam, solo contenuti di valore.
      </p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" aria-label="Iscrizione alla newsletter">
        <label for="newsletter-email" class="sr-only">Indirizzo email</label>
        <input
          id="newsletter-email"
          type="email"
          placeholder="La tua email"
          required
          aria-required="true"
          class="flex-1 px-4 py-3 rounded-lg border border-border bg-card-bg focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"
        />
        <button type="submit" class="btn-primary whitespace-nowrap">
          Iscriviti
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
