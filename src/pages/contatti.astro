---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contatti" description="Contatta la redazione di Intelligenza Etica per domande, suggerimenti o collaborazioni.">
  <article class="fade-in">
    <header class="container-site py-12 md:py-20">
      <div class="content-container text-center">
        <h1 class="mb-6">Contatti</h1>
        <p class="text-xl text-text-secondary">
          Hai domande, suggerimenti o vuoi collaborare con noi?<br />
          Siamo qui per ascoltarti.
        </p>
      </div>
    </header>

    <section class="container-site pb-20">
      <div class="max-w-2xl mx-auto">
        <div class="card">
          <form class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium mb-2">Nome</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-lg border border-border bg-card-bg focus:outline-none focus:border-accent"
                placeholder="Il tuo nome"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-border bg-card-bg focus:outline-none focus:border-accent"
                placeholder="la.tua@email.com"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium mb-2">Argomento</label>
              <select
                id="subject"
                name="subject"
                class="w-full px-4 py-3 rounded-lg border border-border bg-card-bg focus:outline-none focus:border-accent"
              >
                <option value="">Seleziona un argomento</option>
                <option value="general">Domanda generale</option>
                <option value="feedback">Feedback sul sito</option>
                <option value="collaboration">Proposta di collaborazione</option>
                <option value="error">Segnalazione errore</option>
                <option value="other">Altro</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium mb-2">Messaggio</label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                class="w-full px-4 py-3 rounded-lg border border-border bg-card-bg focus:outline-none focus:border-accent resize-none"
                placeholder="Scrivi il tuo messaggio..."
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full">
              Invia messaggio
            </button>
          </form>
        </div>

        <div class="mt-12 text-center">
          <h2 class="text-xl font-serif mb-4">Altri modi per contattarci</h2>
          <p class="text-text-secondary mb-4">
            Puoi anche scriverci direttamente a:
          </p>
          <a
            href="mailto:info@intelligenzaetica.blog"
            class="text-accent hover:text-accent-dark font-medium"
          >
            info@intelligenzaetica.blog
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
