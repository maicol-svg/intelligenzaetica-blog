---
import BaseLayout from './BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import AIDisclosure from '../components/AIDisclosure.astro';

interface Props {
  title: string;
  description: string;
  author: string;
  category: string;
  publishedAt: string;
  featuredImage?: string;
  reviewedBy?: string;
  humanReview?: boolean;
  tags?: string[];
}

const {
  title,
  description,
  author,
  category,
  publishedAt,
  featuredImage,
  reviewedBy = 'sofia',
  humanReview = false,
  tags = [],
} = Astro.props;

const categoryLabels: Record<string, string> = {
  'ia-etica': 'IA & Etica',
  'tech': 'Tech & Innovazione',
  'tutorial': 'Tutorial',
  'finanza': 'Finanza & Lavoro',
  'psicologia': 'Psicologia',
  'ecosostenibile': 'IA Ecosostenibile',
};

const formattedDate = new Date(publishedAt).toLocaleDateString('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={title} description={description} image={featuredImage}>
  <article class="fade-in">
    <!-- Article Header -->
    <header class="container-site py-12 md:py-16">
      <div class="content-container">
        <div class="flex items-center gap-3 mb-6">
          <a
            href={`/categoria/${category}`}
            class="text-sm font-medium text-accent-dark uppercase tracking-wide hover:text-accent"
          >
            {categoryLabels[category] || category}
          </a>
          <span class="text-border">|</span>
          <time class="text-sm text-text-secondary" datetime={publishedAt}>
            {formattedDate}
          </time>
        </div>

        <h1 class="text-3xl md:text-5xl mb-6">{title}</h1>

        <p class="text-xl text-text-secondary mb-8">{description}</p>

        <AuthorCard author={author} compact />
      </div>
    </header>

    <!-- Featured Image -->
    {featuredImage && (
      <div class="container-site pb-8">
        <div class="max-w-4xl mx-auto">
          <img
            src={featuredImage}
            alt={title}
            class="w-full rounded-lg"
          />
        </div>
      </div>
    )}

    <!-- Article Content -->
    <div class="container-site pb-12">
      <div class="content-container prose-article">
        <slot />
      </div>
    </div>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="container-site pb-8">
        <div class="content-container flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/tag/${tag}`}
              class="px-3 py-1 text-sm bg-border rounded-full hover:bg-accent/20 transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- AI Disclosure -->
    <div class="container-site pb-12">
      <div class="content-container">
        <AIDisclosure author={author} reviewedBy={reviewedBy} humanReview={humanReview} />
      </div>
    </div>

    <!-- Author Card Full -->
    <div class="container-site pb-16">
      <div class="content-container">
        <h3 class="text-lg font-serif mb-4">L'autore</h3>
        <AuthorCard author={author} />
      </div>
    </div>
  </article>
</BaseLayout>
