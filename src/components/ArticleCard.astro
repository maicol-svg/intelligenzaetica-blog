---
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  author: string;
  publishedAt: string;
  featuredImage?: string;
}

const { title, description, slug, category, author, publishedAt, featuredImage } = Astro.props;

const categoryLabels: Record<string, string> = {
  'ia-etica': 'IA & Etica',
  'tech': 'Tech & Innovazione',
  'tutorial': 'Tutorial',
  'finanza': 'Finanza & Lavoro',
  'psicologia': 'Psicologia',
  'ecosostenibile': 'IA Ecosostenibile',
  'sport': 'IA & Sport',
  'salute': 'IA & Salute',
  'creativita': 'IA & Creatività',
  'quotidiano': 'Vita Quotidiana',
};

const authorNames: Record<string, string> = {
  'marco': 'Marco',
  'elena': 'Elena',
  'luca': 'Luca',
};

const formattedDate = new Date(publishedAt).toLocaleDateString('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class="card group fade-in">
  {featuredImage && (
    <a href={`/articolo/${slug}`} class="block mb-4 -mx-6 -mt-6 overflow-hidden rounded-t-lg">
      <img
        src={featuredImage}
        alt={title}
        class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    </a>
  )}

  <div class="flex items-center gap-3 mb-3">
    <a
      href={`/categoria/${category}`}
      class="text-xs font-medium text-accent-darker uppercase tracking-wide hover:underline"
    >
      {categoryLabels[category] || category}
    </a>
    <span class="text-border">|</span>
    <time class="text-xs text-text-secondary" datetime={publishedAt}>
      {formattedDate}
    </time>
  </div>

  <h2 class="text-xl font-serif font-semibold mb-2 group-hover:text-accent-dark transition-colors">
    <a href={`/articolo/${slug}`}>{title}</a>
  </h2>

  <p class="text-text-secondary text-sm mb-4 line-clamp-3">
    {description}
  </p>

  <div class="flex items-center justify-between pt-4 border-t border-border">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center">
        <span class="text-xs font-medium text-accent-dark">
          {authorNames[author]?.[0] || author[0].toUpperCase()}
        </span>
      </div>
      <span class="text-sm text-text-secondary">
        {authorNames[author] || author}
        <span class="badge-ia ml-1">IA</span>
      </span>
    </div>

    <a
      href={`/articolo/${slug}`}
      class="text-sm font-medium text-accent-dark hover:text-accent-darker hover:underline inline-flex items-center gap-1"
    >
      Leggi
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
