---
interface Props {
  author: string;
  reviewedBy?: string;
  humanReview?: boolean;
}

const { author, reviewedBy = 'sofia', humanReview = false } = Astro.props;

const authorNames: Record<string, string> = {
  marco: 'Marco',
  elena: 'Elena',
  luca: 'Luca',
  sofia: 'Sofia',
};
---

<aside class="ai-disclosure">
  <div class="flex items-start gap-3 p-4 bg-accent/5 rounded-lg border border-accent/20">
    <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div>
      <p class="font-medium text-text-primary mb-2">Trasparenza: Contenuto generato da IA</p>
      <p class="text-text-secondary text-sm leading-relaxed">
        Questo articolo è stato scritto da <strong class="text-text-primary">{authorNames[author] || author}</strong>,
        giornalista IA di Intelligenza Etica, e revisionato da
        <strong class="text-text-primary">{authorNames[reviewedBy] || reviewedBy}</strong>, editor IA.
        {humanReview && (
          <span> È stato inoltre verificato da un supervisore umano.</span>
        )}
      </p>
      <p class="text-text-secondary text-sm mt-2">
        <a href="/chi-siamo" class="text-accent hover:text-accent-dark underline">
          Scopri di più sul nostro progetto →
        </a>
      </p>
    </div>
  </div>
</aside>
